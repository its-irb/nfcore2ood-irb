#!/usr/bin/env bash

set -euo pipefail

# Export the environment module shell function when OOD starts this script
# from a non-login shell.
[[ $(type -t module || true) == "function" ]] && export -f module

# IRB-03: The working directory is mandatory and must not be inside the user's home
# (it is also checked in submit.yml.erb; this is the safety net).
workdir="<%= context.workdir.to_s.strip %>"
if [[ -z "${workdir// }" ]]; then
  echo "ERROR: the working directory is required." >&2
  exit 1
fi
if [[ "${workdir}" != /* ]]; then
  echo "ERROR: the working directory must be an absolute path." >&2
  exit 1
fi
workdir_real="$(realpath -m -- "${workdir}")"
home_real="$(realpath -m -- "${HOME}")"
if [[ "${workdir_real}" == "${home_real}" || "${workdir_real}" == "${home_real}/"* ]]; then
  echo "ERROR: the working directory cannot be inside your home directory (${home_real})." >&2
  exit 1
fi

# IRB-03: Same rule for the results directory (only absolute paths are checked; a
# relative outdir lives inside the validated working directory).
outdir_param="<%= (context.outdir.to_s.strip rescue '') %>"
if [[ "${outdir_param}" == /* ]]; then
  outdir_real="$(realpath -m -- "${outdir_param}")"
  if [[ "${outdir_real}" == "${home_real}" || "${outdir_real}" == "${home_real}/"* ]]; then
    echo "ERROR: the output directory cannot be inside your home directory (${home_real})." >&2
    exit 1
  fi
fi

mkdir -p "$workdir"
cp nf-params.json "$workdir/"
cd "$workdir"

resume_flag=()
if [[ "<%= context.resume.to_s.strip %>" == "1" ]]; then
  resume_flag+=("-resume")
fi

# If configured, source the same environment file that was used during app
# generation so runtime defaults stay aligned with generation defaults.
nf2ood_env_file="__NF2OOD_ENV_FILE__"
if [[ -n "${nf2ood_env_file}" && -r "${nf2ood_env_file}" ]]; then
  # shellcheck disable=SC1090
  source "${nf2ood_env_file}"
fi

module_name="${NF2OOD_MODULE_NAME:-__NF2OOD_MODULE_NAME__}"
container_module="${NF2OOD_CONTAINER_MODULE:-__NF2OOD_CONTAINER_MODULE__}"
pipeline_root="${NF2OOD_PIPELINE_ROOT:-__NF2OOD_PIPELINE_ROOT__}"
slurm_profile="${NF2OOD_SLURM_PROFILE:-__NF2OOD_SLURM_PROFILE__}"
nextflow_version="<%= context.nextflow_version.to_s.strip %>"

if [[ $(type -t module || true) == "function" ]]; then
  module purge
  if [[ -n "${module_name}" ]]; then
    if [[ -n "${nextflow_version}" ]]; then
      module load "${module_name}/${nextflow_version}"
    else
      module load "${module_name}"
    fi
  fi
  if [[ -n "${container_module}" ]]; then
    module load "${container_module}"
  fi
fi

# IRB-01: Partition chosen in the form: the launch job runs on it (see submit.yml.erb)
# and the irb Nextflow profile sends every task to the same partition.
export NF_QUEUE="<%= context.auto_queues_cpu %>"
export SBATCH_PARTITION="${NF_QUEUE}"
if [[ -z "${NF_QUEUE}" ]]; then
  echo "ERROR: no partition selected in the form" >&2
  exit 1
fi

# IRB-05: Container images are read from the shared library declared in the
# institutional config (singularity.libraryDir); nothing is cached here.
pipeline_path="${pipeline_root}/__PIPELINE_NAME__/__PIPELINE_VERSION_PATH__"
export projectDir="${pipeline_path}"
export baseDir="${pipeline_path}"

# IRB-06: Nextflow >= 26 has two config parsers (v1 legacy, v2 strict) and each pipeline version
# works with only one of them. The download step records the right one next to the
# pipeline code; when the file is missing, the value inherited from the environment is kept.
parser_file="${pipeline_path%/*}/nxf_syntax_parser"
if [[ -r "${parser_file}" ]]; then
  parser_value="$(tr -d '[:space:]' < "${parser_file}")"
  if [[ "${parser_value}" == "v1" || "${parser_value}" == "v2" ]]; then
    export NXF_SYNTAX_PARSER="${parser_value}"
  fi
fi

# Normalize the rendered parameter file before running Nextflow.
sed -i.bak -E '/:[[:space:]]*,/d; /"[[:space:]]*"/d' nf-params.json
sed -i.bak -E "s@\$(projectDir)@${projectDir}@g; s@\$(baseDir)@${baseDir}@g; s/\"None\"/null/g" nf-params.json
rm -f nf-params.json.bak

nextflow_command=(nextflow run "${pipeline_path}" -params-file nf-params.json)

# IRB-02, IRB-04: Slurm only: profile "<site profile>,<partition>" (the partition profile must
# come after the site profile so it overrides the defaults).
nextflow_command+=("-profile" "${slurm_profile},${NF_QUEUE}" "-c" "${NF2OOD_PROFILE_CONFIG:?NF2OOD_PROFILE_CONFIG is not set; check nf2ood.env}")

nextflow_command+=("${resume_flag[@]}")

printf 'Executing: %q ' "${nextflow_command[@]}"
printf '\n'
"${nextflow_command[@]}"
