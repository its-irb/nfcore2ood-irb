<%-
  # IRB-03: The working directory is mandatory and must not live in the user's home.
  wd = workdir.to_s.strip
  homes = [Dir.home, (File.realpath(Dir.home) rescue Dir.home)].uniq
  full = File.expand_path(wd)
  if wd.empty?
    raise "The working directory is required."
  elsif !wd.start_with?("/")
    raise "The working directory must be an absolute path."
  elsif homes.any? { |h| full == h || full.start_with?(h + "/") }
    raise "The working directory cannot be inside your home directory (#{homes.first}). Use a data or project folder."
  end

  # IRB-03: Results must not go to the home either. A relative outdir is resolved
  # inside the (already validated) working directory, so only absolute paths
  # are checked. Skipped when the pipeline has no "outdir" field.
  out = (outdir.to_s.strip rescue '')
  if out.start_with?("/")
    full_out = File.expand_path(out)
    if homes.any? { |h| full_out == h || full_out.start_with?(h + "/") }
      raise "The output directory cannot be inside your home directory (#{homes.first}). Use a data or project folder."
    end
  end
-%>
---
batch_connect:
  template: "basic"
  conn_params:
    - working_path
    - output_log_path

script:
  email_on_started: <%= bc_email_on_started.to_s == "1" %>
  email_on_terminated: false
  job_name: "OnDemand/__PIPELINE_NAME__"
  native:
    - "--time"
    - "<%= bc_num_hours %>:00:00"
    - "--nodes"
    - "1"
    # IRB-01: the launch job runs on the partition chosen in the form (auto_queues_cpu).
    <%- if auto_queues_cpu.to_s.strip != "" -%>
    - "-p"
    - "<%= auto_queues_cpu %>"
    <%- end -%>
    # IRB-02: Slurm only, fixed 2 CPUs / 12G: this job only orchestrates Nextflow.
    - "-n"
    - "2"
    - "--mem"
    - "12G"
